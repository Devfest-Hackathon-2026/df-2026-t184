rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 既定は全拒否。yorimichi-stg / yorimichi-prod 両 DB にこの内容がデプロイされている。
    // データアクセスを始めるときは、必要なコレクションだけ、
    // 認証済みユーザー本人に限って許可するルールを追加すること。
    match /{document=**} {
      allow read, write: if false;
    }

    // 例: users/{uid} は本人だけが読み書きできる（有効化するのは実装時）。
    // match /users/{uid} {
    //   allow read, write: if request.auth != null && request.auth.uid == uid;
    // }
  }
}
