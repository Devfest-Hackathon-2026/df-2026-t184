{
  "firestore": [
    {
      "database": "yorimichi-stg",
      "rules": "firestore.rules",
      "indexes": "firestore.indexes.json"
    },
    {
      "database": "yorimichi-prod",
      "rules": "firestore.rules",
      "indexes": "firestore.indexes.json"
    }
  ],
  "apphosting": [
    {
      "backendId": "yorimichi-stg",
      "rootDir": "/",
      "ignore": [
        "node_modules",
        ".git",
        ".next",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "storybook-static",
        ".env",
        ".env*",
        "**/.env",
        "**/.env*",
        "gha-creds-*.json",
        "**/gha-creds-*.json"
      ]
    },
    {
      "backendId": "yorimichi-prod",
      "rootDir": "/",
      "ignore": [
        "node_modules",
        ".git",
        ".next",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "storybook-static",
        ".env",
        ".env*",
        "**/.env",
        "**/.env*",
        "gha-creds-*.json",
        "**/gha-creds-*.json"
      ]
    }
  ],
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "ui": {
      "enabled": true
    }
  }
}
