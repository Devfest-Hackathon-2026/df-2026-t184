{
  "firestore": [
    {
      "database": "yorimichi-stg",
      "rules": "firestore.rules",
      "indexes": "firestore.indexes.json"
    },
    {
      "database": "yorimichi-prod",
      "rules": "firestore.rules",
      "indexes": "firestore.indexes.json"
    }
  ],
  "apphosting": [
    {
      "backendId": "yorimichi-stg",
      "rootDir": "/",
      "ignore": [
        "node_modules",
        ".git",
        ".next",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "storybook-static"
      ]
    },
    {
      "backendId": "yorimichi-prod",
      "rootDir": "/",
      "ignore": [
        "node_modules",
        ".git",
        ".next",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "storybook-static"
      ]
    }
  ],
  "emulators": {
    "auth": { "port": 9099 },
    "firestore": { "port": 8080 },
    "ui": { "enabled": true }
  }
}
