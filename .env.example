# .env.local にコピーして値を入れる（.env.local はコミットしない）
# 環境ごとの全体像は docs/environments.md を参照。

# 実行環境の選択: 未設定なら local として動く。
# ローカルで stg/prod と同じ DB を直接見る場合だけ stg / prod を設定する
# （その場合は対応する NEXT_PUBLIC_FIREBASE_DATABASE_ID も必須）。
NEXT_PUBLIC_APP_ENV=local

# Gemini（サーバー側のみ。NEXT_PUBLIC_ を付けない）
# デプロイ環境では Secret Manager の STG_/PROD_GEMINI_API_KEY を参照する。
GEMINI_API_KEY=
# 省略時は gemini-2.5-flash
GEMINI_MODEL=

# Google Maps（ブラウザに公開される。リファラー制限とAPI制限を必ずかける）
# ローカルでは STG_GOOGLE_MAPS_API_KEY の値を使う（localhost:3000 許可済み）。
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Firebase Web アプリの設定値（公開される値）
# ローカルでは stg の Web アプリ値を使う。APP_ID は .env.local にだけ書く。
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=df-2026-t184-prod.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=df-2026-t184-prod
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1031159186960
# stg: 1:1031159186960:web:98001fdfed19e46405ec95
# prod: 1:1031159186960:web:5a1c4dd734cfeb5405ec95
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firestore の接続先 DB。local では省略可（= (default) DB）。
# APP_ENV=stg のとき yorimichi-stg、prod のとき yorimichi-prod が必須。
# NEXT_PUBLIC_FIREBASE_DATABASE_ID=

# Cloud Storage は未プロビジョニング（値を設定しても使えない）。
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=

# Auth / Firestore のエミュレータを使うなら true（firebase emulators:start 併用）
NEXT_PUBLIC_FIREBASE_EMULATOR=false
