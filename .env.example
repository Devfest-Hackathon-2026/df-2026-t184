# .env.local にコピーして値を入れる（.env.local はコミットしない）
# 環境ごとの全体像は docs/environments.md を参照。

# 開発時に未設定なら local。本番ビルドでは明示が必要。
# ローカルで stg/prod と同じ DB を直接見る場合だけ stg / prod を設定する
# （対応するDB IDが必須。EMULATOR=false にし、Admin用エミュレータホストも解除する）。
NEXT_PUBLIC_APP_ENV=local

# Gemini（サーバー側のみ。NEXT_PUBLIC_ を付けない）
# デプロイ環境では Secret Manager の STG_/PROD_GEMINI_API_KEY を参照する。
GEMINI_API_KEY=
# 省略時は gemini-2.5-flash
GEMINI_MODEL=

# Google Maps（ブラウザに公開される。リファラー制限とAPI制限を必ずかける）
# ローカルでは STG_GOOGLE_MAPS_API_KEY の値を使う（localhost:3000 許可済み）。
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Firebase Web アプリの設定値（公開される値）
# local + エミュレータではAPIキーとprojectIdが空ならデモ値を補う。
# 実DBを使う場合は APP_ENV=stg とし、stg のWebアプリ設定を入力する。
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# stg: 1:1031159186960:web:98001fdfed19e46405ec95
# prod: 1:1031159186960:web:5a1c4dd734cfeb5405ec95
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firestore の接続先。local で省略するとエミュレータの (default) DB。
# local では実環境のDB名を拒否する。
# APP_ENV=stg のとき yorimichi-stg、prod のとき yorimichi-prod が必須。
# NEXT_PUBLIC_FIREBASE_DATABASE_ID=

# Cloud Storage は未プロビジョニング（値を設定しても使えない）。
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=

# local のFirebase利用には true が必須。
# firebase emulators:start --project demo-yorimichi と併用する。
NEXT_PUBLIC_FIREBASE_EMULATOR=true
# Admin SDK側のホストは local 時に自動設定される。手動設定する場合も次と一致させる。
# FIRESTORE_EMULATOR_HOST=localhost:8080
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
